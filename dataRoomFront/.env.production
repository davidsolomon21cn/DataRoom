# 生产环境配置、一体化部署方式不用配置URL全路径
VITE_API_BASE_URL=/dataRoom
# 资源基础路径
VITE_RESOURCE_BASE_URL=/dataRoom/static
# Token 名称，需与后端 dataroom.jwt.tokenKey 保持一致
VITE_TOKEN_KEY=dataRoomToken
# 前端路由模式，可选值 hash、history
VITE_ROUTER_MODE=hash
# CAS 单点登录
VITE_CAS_ENABLE=false
VITE_CAS_LOGIN_URL=
VITE_CAS_LOGOUT_URL=
# RSA公钥配置
VITE_RSA_PUBLIC_
