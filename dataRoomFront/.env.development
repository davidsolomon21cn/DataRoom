# 开发环境配置
VITE_API_BASE_URL=http://localhost:8081/dataRoom
# 资源基础路径
VITE_RESOURCE_BASE_URL=http://localhost:8081/dataRoom/static
# Token 名称，需与后端 dataroom.jwt.tokenKey 保持一致
VITE_TOKEN_KEY=dataRoomToken
# 前端路由模式，可选值 hash、history
VITE_ROUTER_MODE=hash
# CAS 单点登录
VITE_CAS_ENABLE=false
# 登录地址，注意service的值需要进行URL编码
VITE_CAS_LOGIN_URL=http://127.0.0.1:8080/cas/login?service=http%3A%2F%2F127.0.0.1%3A8081%2FdataRoom%2Fcas%2Flogin
# 登出地址，注意service的值需要进行URL编码
VITE_CAS_LOGOUT_URL=http://127.0.0.1:8080/cas/logout?service=http%3A%2F%2F127.0.0.1%8080%2Fcas%2Flogin%3Fservice%3Dhttp%253A%252F%252F127.0.0.1%253A8081%252FdataRoom%252Fcas%252Flogin
# RSA公钥配置
VITE_RSA_PUBLIC_
